{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "esbuild scripts/check-solver.ts --bundle --platform=node --format=cjs --outfile=node_modules/.cache/check-solver.cjs --log-level=warning && node node_modules/.cache/check-solver.cjs",
    "check:ui": "esbuild scripts/check-ui.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.cache/check-ui.cjs --log-level=warning && node node_modules/.cache/check-ui.cjs",
    "verify": "npm run typecheck && npm run check && npm run check:ui"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vite": "7.3.2",
    "vite-plugin-singlefile": "2.3.0"
  }
}
